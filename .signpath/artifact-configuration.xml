<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath's artifact configuration for MDM's Windows builds (release.yml), the project's
     default one: SignPath keeps its own copy, so a change here is pasted into it too.
     A release sends two signing requests, each a GitHub artifact of the release's run (a zip):
     1. the programs and Inno Setup's uninstaller of every processor built, one folder each
        (x64/, arm64/, x86/; job windows-to-sign),
     2. the installers made from those (MisterDownloadManager-<version>-setup[-arm64|-x86].exe at
        the root; job windows-installers).
     Only these names are signed (Authenticode, SHA-256), and each must say it is this version of
     Mister Download Manager: its product name, and as its product version the "version" the
     workflow passes (Cargo.toml's), which the installers' names carry too. Every entry may be
     missing (each request holds one of the two sets, and a processor whose build failed is left
     out); release.yml requires x64's. "commit" and "ref" are the commit and the Git ref (a tag
     vX.Y.Z for a release) the files were built from, shown on the signing request beside its
     origin for the approver.
     The programs take their name and version from tools/build/version_info.rs. The installer and
     its uninstaller take them from tools/installer/mdm.iss, but Inno Setup writes them over
     fixed-width placeholders and keeps the placeholders' trailing spaces: the product name is 60
     characters, the product version 50 (Compiler.ExeUpdateFunc.pas, UpdateStringValue). Their
     entries below expect exactly that, which holds for a version of 5 characters (0.5.2);
     another length, or an Inno Setup whose widths differ, fails the signing request instead of
     signing something unchecked. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
    <parameter name="commit" required="true" />
    <parameter name="ref" required="true" />
  </parameters>
  <zip-file>
    <pe-file-set product-name="Mister Download Manager" product-version="${version}">
      <include path="x64/misterdownloadmanager.exe" min-matches="0" />
      <include path="x64/misterdownloadmanager-nmhost.exe" min-matches="0" />
      <include path="x64/misterdownloadmanager-cli.exe" min-matches="0" />
      <include path="x64/misterdownloadmanager-mcp.exe" min-matches="0" />
      <include path="x64/uninst-*.e32.exe" min-matches="0"
        product-name="Mister Download Manager                                     "
        product-version="${version}                                             " />
      <include path="arm64/misterdownloadmanager.exe" min-matches="0" />
      <include path="arm64/misterdownloadmanager-nmhost.exe" min-matches="0" />
      <include path="arm64/misterdownloadmanager-cli.exe" min-matches="0" />
      <include path="arm64/misterdownloadmanager-mcp.exe" min-matches="0" />
      <include path="arm64/uninst-*.e32.exe" min-matches="0"
        product-name="Mister Download Manager                                     "
        product-version="${version}                                             " />
      <include path="x86/misterdownloadmanager.exe" min-matches="0" />
      <include path="x86/misterdownloadmanager-nmhost.exe" min-matches="0" />
      <include path="x86/misterdownloadmanager-cli.exe" min-matches="0" />
      <include path="x86/misterdownloadmanager-mcp.exe" min-matches="0" />
      <include path="x86/uninst-*.e32.exe" min-matches="0"
        product-name="Mister Download Manager                                     "
        product-version="${version}                                             " />
      <include path="MisterDownloadManager-${version}-setup.exe" min-matches="0"
        product-name="Mister Download Manager                                     "
        product-version="${version}                                             " />
      <include path="MisterDownloadManager-${version}-setup-arm64.exe" min-matches="0"
        product-name="Mister Download Manager                                     "
        product-version="${version}                                             " />
      <include path="MisterDownloadManager-${version}-setup-x86.exe" min-matches="0"
        product-name="Mister Download Manager                                     "
        product-version="${version}                                             " />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
