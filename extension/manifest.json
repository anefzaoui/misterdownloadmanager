{
    "manifest_version":  3,
    "default_locale":  "en",
    "name":  "__MSG_name__",
    "version":  "0.1.0",
    "description":  "__MSG_description__",
    "key":  "",
    "permissions":  [
                        "downloads",
                        "contextMenus",
                        "nativeMessaging",
                        "cookies",
                        "storage"
                    ],
    "host_permissions":  [
                             "\u003call_urls\u003e"
                         ],
    "background":  {
                       "service_worker":  "background.js"
                   },
    "content_scripts":  [
        {
            "matches":  ["<all_urls>"],
            "js":  ["video.js"],
            "all_frames":  true,
            "run_at":  "document_idle"
        }
    ],
    "icons":  {
                  "16":  "icons/icon-16.png",
                  "32":  "icons/icon-32.png",
                  "48":  "icons/icon-48.png",
                  "128":  "icons/icon-128.png"
              }
}